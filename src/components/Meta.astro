---
// src/components/Meta.astro

import { getImage } from "astro:assets";
import { OG, SEO, SITE } from "@data/constants";
import faviconSvgSrc from "@images/icon.svg";
import faviconSrc from "@images/icon2.png";
import HreflangLinks from "@components/HreflangLinks.astro";
import { ES_READY } from "@/config/i18n";

interface Props {
  title?: string;
  meta?: string;
  structuredData?: object;
  alternates?: {
    en?: string;
    fr?: string;
    es?: string;
  };
}

const currentLocale = Astro.currentLocale || "en";

const defaultDescriptions: Record<string, string> = {
  en: SITE.description,
  fr: "Kraffe Roasters conçoit et fabrique des machines à torréfier le café commerciales et industrielles de haute précision pour les professionnels du café.",
  es: "Kraffe Roasters diseña y fabrica máquinas tostadoras de café comerciales e industriales de alta precisión para profesionales del café.",
};

const {
  title = SITE.title,
  meta = defaultDescriptions[currentLocale] || SITE.description,
  structuredData = SEO.structuredData,
  alternates,
} = Astro.props;

const siteBaseURL = `${Astro.site || "https://krafferoasters.com"}`;
const author = SITE.author;

// Canonical URL oluşturma
const canonicalURL = new URL(Astro.url.pathname, siteBaseURL);
if (!canonicalURL.pathname.endsWith("/")) {
  canonicalURL.pathname += "/";
}
const canonical = canonicalURL.href;

// Page specific meta titles and descriptions
const ogTitle = title || OG.title;
const ogDescription = meta || OG.description;

const localeMap: Record<string, string> = {
  en: "en_US",
  fr: "fr_FR",
  es: "es_ES",
};
const ogLocale = localeMap[currentLocale] || "en_US";

const siteNames: Record<string, string> = {
  en: "Kraffe Roasters",
  fr: "Kraffe Roasters",
  es: "Kraffe Roasters",
};
const ogSiteName = siteNames[currentLocale] || "Kraffe Roasters";

// Determine alternate locales (exclude Spanish if not ready yet)
const availableLocales = ["en_US", "fr_FR", ...(ES_READY ? ["es_ES"] : [])];
const alternateLocales = availableLocales.filter((loc) => loc !== ogLocale);

// Temporary noindex for Spanish pages while containing placeholders
const isSpanish = currentLocale === "es" || Astro.url.pathname.startsWith("/es");
const shouldNoIndex = isSpanish && !ES_READY;

const socialImageRes = await getImage({
  src: OG.image,
  width: 1200,
  height: 600,
});
const socialImage = new URL(socialImageRes.src, siteBaseURL).href;

const faviconSvg = await getImage({
  src: faviconSvgSrc,
  format: "svg",
});

const appleTouchIcon = await getImage({
  src: faviconSrc,
  width: 180,
  height: 180,
  format: "png",
});
---

{
  structuredData && (
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
  )
}
<meta charset="utf-8" />
<meta content={meta} name="description" />
<meta name="web_author" content={author} />
<meta
  name="viewport"
  content="width=device-width, initial-scale=1.0, maximum-scale=5.0, minimum-scale=1.0"
/>
<meta http-equiv="X-UA-Compatible" content="ie=edge" />
<link rel="canonical" href={canonical} />

{shouldNoIndex && <meta name="robots" content="noindex, nofollow" />}

<HreflangLinks alternates={alternates} />

<!-- Facebook Meta Tags -->
<meta property="og:locale" content={ogLocale} />
{alternateLocales.map((altLoc) => (
  <meta property="og:locale:alternate" content={altLoc} />
))}
<meta property="og:url" content={canonical} />
<meta property="og:type" content="website" />
<meta property="og:title" content={ogTitle} />
<meta property="og:site_name" content={ogSiteName} />
<meta property="og:description" content={ogDescription} />
<meta property="og:image" content={socialImage} />
<meta content="1200" property="og:image:width" />
<meta content="600" property="og:image:height" />
<meta content="image/png" property="og:image:type" />

<!-- Twitter Meta Tags -->
<meta name="twitter:card" content="summary_large_image" />
<meta property="twitter:domain" content={siteBaseURL} />
<meta property="twitter:url" content={canonical} />
<meta name="twitter:title" content={ogTitle} />
<meta name="twitter:description" content={ogDescription} />
<meta name="twitter:image" content={socialImage} />

<!-- Links to the webmanifest and sitemap -->
<link rel="manifest" href="/manifest.json" />
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- Links for favicons -->
<link href="/favicon.ico" rel="icon" sizes="any" type="image/x-icon" />
<link href={faviconSvg.src} rel="icon" type="image/svg+xml" sizes="any" />
<meta name="mobile-web-app-capable" content="yes" />
<link href={appleTouchIcon.src} rel="apple-touch-icon" />
<link href={appleTouchIcon.src} rel="shortcut icon" />
<meta name="theme-color" content="#facc15" />
