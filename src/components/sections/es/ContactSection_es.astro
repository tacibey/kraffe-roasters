  "Sierra Leona", "Singapur", "Siria", "Somalia", "Sri Lanka", "Sudáfrica", "Sudán", "Sudán del Sur", "Suecia", "Suiza",
  "Surinam", "Tailandia", "Tanzania", "Tayikistán", "Timor Oriental", "Togo", "Tonga", "Trinidad y Tobago", "Túnez", "Turkmenistán",
  "Turquía", "Tuvalu", "Ucrania", "Uganda", "Uruguay", "Uzbekistán", "Vanuatu", "Vaticano", "Venezuela", "Vietnam",
  "Yemen", "Yibuti", "Zambia", "Zimbabue"
];

const inputBaseClass_es = "py-3 px-4 block w-full rounded-lg border border-neutral-200 bg-neutral-50 text-sm text-neutral-700 placeholder:text-neutral-500 focus:border-orange-500 focus:outline-hidden focus:ring-1 focus:ring-orange-500 disabled:pointer-events-none disabled:opacity-50 dark:border-neutral-600 dark:bg-neutral-700/30 dark:text-neutral-300 dark:placeholder:text-neutral-400 dark:focus:ring-orange-600";
---

<script src="https://unpkg.com/@botpoison/browser" async></script>

<section class="mx-auto max-w-(--breakpoint-2xl) px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
  <div class="mx-auto max-w-2xl text-center">
    <h1 class="text-balance text-2xl font-bold tracking-tight text-neutral-800 dark:text-neutral-200 md:text-4xl md:leading-tight">
      {title_es}
    </h1>
    <p class="mt-1 text-pretty text-neutral-600 dark:text-neutral-400">
      {subTitle_es}
    </p>
  </div>

  <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-x-10 lg:gap-x-16">
    <div class="flex flex-col justify-center">
      <Image
        class="w-full h-full object-cover rounded-xl shadow-lg"
        src={kraffeContact}
        alt="Máquina tostadora de café Kraffe Roasters en una tostaduría profesional"
        format={"avif"}
        loading={"eager"}
      />
    </div>

    <div>
      <div class="flex flex-col rounded-xl p-4 sm:p-6 lg:p-8 bg-neutral-100 dark:bg-neutral-800 mb-8">
        <h2 class="text-lg font-bold text-neutral-700 dark:text-neutral-300">
          {formTitle_es}
        </h2>
        <form
          id="contact-form-kraffe-es"
          action={`https://submit-form.com/${formsparkFormId_ES}`}
          method="POST"
          data-botpoison-public-key={botpoisonPublicKey_ES}
        >
          <input type="text" name="_honeypot" style="display: none;" tabindex="-1" autocomplete="off"/>
          <input type="hidden" name="_redirect" value="https://krafferoasters.com/thanks" />

          <div class="grid gap-4">
            <div>
              <label for="contact-name-es" class="sr-only">Nombre y Apellido</label>
              <input type="text" id="contact-name-es" name="name" class={inputBaseClass_es} placeholder="Nombre y Apellido" required />
            </div>
            <div>
              <label for="contact-company-es" class="sr-only">Empresa o Tostaduría</label>
              <input type="text" id="contact-company-es" name="company" class={inputBaseClass_es} placeholder="Empresa o Tostaduría" />
            </div>
            <div>
              <label for="contact-email-es" class="sr-only">Correo electrónico profesional</label>
              <input type="email" id="contact-email-es" name="email" class={inputBaseClass_es} placeholder="Correo electrónico profesional" required autocomplete="email"/>
            </div>
            <div>
              <label for="contact-phone-number-es" class="sr-only">Número de teléfono</label>
              <div class="flex rounded-lg shadow-sm">
                <div class="px-3 inline-flex items-center min-w-fit rounded-s-lg border border-e-0 border-neutral-200 bg-neutral-200 dark:bg-neutral-700 dark:border-neutral-600">
                  <span class="text-sm text-neutral-500 dark:text-neutral-400">+</span>
                </div>
                <input
                  type="text"
                  id="contact-country-code-es"
                  name="countryCode"
                  class="py-3 px-4 block w-[80px] border-neutral-200 -ms-px text-sm focus:z-10 focus:border-orange-500 focus:ring-orange-500 disabled:opacity-50 disabled:pointer-events-none dark:bg-neutral-700/30 dark:border-neutral-600 dark:text-neutral-300 dark:focus:ring-orange-600 dark:placeholder-neutral-500"
                  placeholder="Prefijo"
                  aria-label="Prefijo país"
                />
                <input
                  type="tel"
                  id="contact-phone-number-es"
                  name="phone"
                  class={`${inputBaseClass_es} rounded-s-none`}
                  placeholder="Número de teléfono"
                  aria-label="Número de teléfono"
                />
              </div>
            </div>
            <div>
              <label for="contact-country-es" class="sr-only">Seleccione su país</label>
              <select id="contact-country-es" name="country" class={inputBaseClass_es + " cursor-pointer"}>
                <option value="" disabled selected>Seleccione su país</option>
                {allCountries_es.map(country => (
                  <option value={country}>{country}</option>
                ))}
              </select>
            </div>
            <div>
              <label for="contact-product-es" class="sr-only">Seleccione el producto de su interés</label>
              <select id="contact-product-es" name="product" class={inputBaseClass_es + " cursor-pointer"}>
                <option value="" disabled selected>Seleccione el producto de su interés</option>
                {productOptions_es.map(option => (
                  <option value={option}>{option}</option>
                ))}
              </select>
            </div>
            <div>
              <label for="contact-details-es" class="sr-only">Detalles del proyecto</label>
              <textarea id="contact-details-es" name="message" rows="4" class={inputBaseClass_es} placeholder="Cuéntenos sobre su proyecto, capacidad requerida o requerimientos técnicos" required></textarea>
            </div>
          </div>
          <div class="mt-4 grid">
            <AuthBtn title="Enviar Solicitud" type="submit" id="contact-submit-button-es" />
          </div>
          <div class="mt-3 text-center">
            <p class="text-sm text-neutral-600 dark:text-neutral-400">
              {formSubTitle_es}
            </p>
          </div>
        </form>
      </div>

      <div class="space-y-8">
        {amirAvatarData && (
            <div class="rounded-xl border border-neutral-200 bg-neutral-100 p-4 shadow-sm dark:border-neutral-700 dark:bg-neutral-800 sm:p-6">
                <ReviewComponent 
                    amirAvatarData={amirAvatarData} 
                    avatars={avatarSrcs} 
                    starCount={starCount_es} 
                    rating={rating_es} 
                    reviews={reviews_es}
                    testimonialText="Increíblemente fácil de operar y ofrece resultados consistentes lote tras lote."
                    testimonialAuthor="Amir Montazer"
                    testimonialRole="Etude Coffee Co."
                    testimonialAvatarAlt="Retrato de Amir Montazer"
                />
            </div>
        )}
        <div class={`space-y-6 divide-y divide-neutral-200 dark:divide-neutral-700 ${!amirAvatarData ? 'mt-0' : ''}`}>
          <div class="pt-6 first:pt-0">
             <ContactIconBlock heading={officeHeading_es} content={officeContent_es} isAddressVisible={true} addressContent={officeAddress_es}>
               <Icon name="mapPin" />
             </ContactIconBlock>
          </div>
          <div class="pt-6 first:pt-0">
             <ContactIconBlock heading={emailHeading_es} content={emailContent_es} isLinkVisible={true} linkTitle={emailLinkTitle_es} linkURL={emailLinkURL_es}>
               <Icon name="envelopeOpen" />
             </ContactIconBlock>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{botpoisonPublicKey_ES && (
  <script is:inline>
    const formElement_es = document.getElementById("contact-form-kraffe-es");
    const buttonElement_es = document.getElementById("contact-submit-button-es");

    if (formElement_es && buttonElement_es) {
      formElement_es.addEventListener("botpoison-challenge-start", function () {
        buttonElement_es.setAttribute("disabled", "disabled");
      });
      formElement_es.addEventListener("botpoison-challenge-success", function () {
        buttonElement_es.removeAttribute("disabled");
      });
      formElement_es.addEventListener("botpoison-challenge-error", function () {
        buttonElement_es.removeAttribute("disabled");
      });
    }
  </script>
)}
