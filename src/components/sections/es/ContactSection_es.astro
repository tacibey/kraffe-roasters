  "https://images.unsplash.com/photo-1541101767792-f9b2b1c4f127?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&&auto=format&fit=facearea&facepad=3&w=300&h=300&q=80",
  "https://images.unsplash.com/photo-1492562080023-ab3db95bfbce?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=facearea&facepad=2&w=300&h=300&q=80",
];

const title_es: string = "Descubra su nueva máquina tostadora de café";
const subTitle_es: string = "Complete nuestro formulario para liberar todo el potencial de sus granos de café.";
const formTitle_es: string = "Solicite un presupuesto personalizado →";
const formSubTitle_es: string = "Le responderemos en un plazo de 1 a 2 días hábiles.";

const officeHeading_es: string = "Nuestra Oficina Central";
const officeContent_es: string = "KRAFFE ROASTERS";
const officeAddress_es: string = "Adalet, Manas Blv. No:39, Folkart Towers A Kule, Kat:34, D:3408, 35530 Bayraklı / Esmirna, Turquía";

const emailHeading_es: string = "Contacto por correo electrónico";
const emailContent_es: string = "¿Prefiere escribirnos directamente? Envíenos un mensaje a";
const emailLinkTitle_es: string = "info@krafferoasters.com";
const emailLinkURL_es: string = "mailto:info@krafferoasters.com";

const rating_es: string = `<span class="font-bold">4,8</span> / 5`;
const starCount_es: number = 4;
const reviews_es: string = `De confianza para <span class="font-bold">Tostadores</span> de todo el mundo`;

const formsparkFormId_ES = "la0JBXKn3";
const botpoisonPublicKey_ES = "pk_237e0502-663f-4b6c-ab78-5a125646b975";

const productOptions_es = [
  "Dimi - Capacidad de lote de 0,5 kg",
  "Primi - Capacidad de lote de 1 kg",
  "KRF-03 (3 kg Comercial)", "KRF-06 (6 kg Comercial)", "KRF-12 (12 kg Comercial)", "KRF-15 (15 kg Comercial)", "KRF-20 (20 kg Comercial)",
  "KRF-30 (30 kg Industrial)", "KRF-60 (60 kg Industrial)", "KRF-120 (120 kg Industrial)", "KRF-180 (180 kg Industrial)", "KRF-240 (240 kg Industrial)",
  "Despedregadora (Destoner)", "Cargador Neumático (Loader)", "Postquemador (Afterburner)"
];

const allCountries_es = [
  "Afganistán", "Albania", "Alemania", "Andorra", "Angola", "Antigua y Barbuda", "Arabia Saudita", "Argelia", "Argentina", "Armenia",
