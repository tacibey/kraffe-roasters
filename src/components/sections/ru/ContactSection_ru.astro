const inputBaseClass_ru = "py-3 px-4 block w-full rounded-lg border border-neutral-200 bg-neutral-50 text-sm text-neutral-700 placeholder:text-neutral-500 focus:border-orange-500 focus:outline-hidden focus:ring-1 focus:ring-orange-500 disabled:pointer-events-none disabled:opacity-50 dark:border-neutral-600 dark:bg-neutral-700/30 dark:text-neutral-300 dark:placeholder:text-neutral-400 dark:focus:ring-orange-600";
---

<script src="https://unpkg.com/@botpoison/browser" async></script>

<section class="mx-auto max-w-(--breakpoint-2xl) px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
  <div class="mx-auto max-w-2xl text-center">
    <h1 class="text-balance text-2xl font-bold tracking-tight text-neutral-800 dark:text-neutral-200 md:text-4xl md:leading-tight">
      {title_ru}
    </h1>
    <p class="mt-1 text-pretty text-neutral-600 dark:text-neutral-400">
      {subTitle_ru}
    </p>
  </div>

  <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-x-10 lg:gap-x-16">
    <div class="flex flex-col justify-center">
      <Image
        class="w-full h-full object-cover rounded-xl shadow-lg"
        src={kraffeContact}
        alt="Ростер для кофе Kraffe Roasters в профессиональном обжарочном цехе"
        format={"avif"}
        loading={"eager"}
      />
    </div>

    <div>
      <div class="flex flex-col rounded-xl p-4 sm:p-6 lg:p-8 bg-neutral-100 dark:bg-neutral-800 mb-8">
        <h2 class="text-lg font-bold text-neutral-700 dark:text-neutral-300">
          {formTitle_ru}
        </h2>
        <form
          id="contact-form-kraffe-ru"
          action={`https://submit-form.com/${formsparkFormId_RU}`}
          method="POST"
          data-botpoison-public-key={botpoisonPublicKey_RU}
        >
          <input type="text" name="_honeypot" style="display: none;" tabindex="-1" autocomplete="off"/>
          <input type="hidden" name="_redirect" value="https://krafferoasters.com/thanks" />

          <div class="grid gap-4">
            <div>
              <label for="contact-name-ru" class="sr-only">Имя и фамилия</label>
              <input type="text" id="contact-name-ru" name="name" class={inputBaseClass_ru} placeholder="Имя и фамилия" required />
            </div>
            <div>
              <label for="contact-company-ru" class="sr-only">Компания или обжарочный цех</label>
              <input type="text" id="contact-company-ru" name="company" class={inputBaseClass_ru} placeholder="Компания или обжарочный цех" />
            </div>
            <div>
              <label for="contact-email-ru" class="sr-only">Рабочий адрес электронной почты</label>
              <input type="email" id="contact-email-ru" name="email" class={inputBaseClass_ru} placeholder="Рабочий адрес электронной почты" required autocomplete="email"/>
            </div>
            <div>
              <label for="contact-phone-number-ru" class="sr-only">Номер телефона</label>
              <div class="flex rounded-lg shadow-sm">
                <div class="px-3 inline-flex items-center min-w-fit rounded-s-lg border border-e-0 border-neutral-200 bg-neutral-200 dark:bg-neutral-700 dark:border-neutral-600">
                  <span class="text-sm text-neutral-500 dark:text-neutral-400">+</span>
                </div>
                <input
                  type="text"
                  id="contact-country-code-ru"
                  name="countryCode"
                  class="py-3 px-4 block w-[80px] border-neutral-200 -ms-px text-sm focus:z-10 focus:border-orange-500 focus:ring-orange-500 disabled:opacity-50 disabled:pointer-events-none dark:bg-neutral-700/30 dark:border-neutral-600 dark:text-neutral-300 dark:focus:ring-orange-600 dark:placeholder-neutral-500"
                  placeholder="Код"
                  aria-label="Код страны"
                />
                <input
                  type="tel"
                  id="contact-phone-number-ru"
                  name="phone"
                  class={`${inputBaseClass_ru} rounded-s-none`}
                  placeholder="Номер телефона"
                  aria-label="Номер телефона"
                />
              </div>
            </div>
            <div>
              <label for="contact-country-ru" class="sr-only">Выберите вашу страну</label>
              <select id="contact-country-ru" name="country" class={inputBaseClass_ru + " cursor-pointer"}>
                <option value="" disabled selected>Выберите вашу страну</option>
                {allCountries_ru.map(country => (
                  <option value={country}>{country}</option>
                ))}
              </select>
            </div>
            <div>
              <label for="contact-product-ru" class="sr-only">Выберите интересующий вас продукт</label>
              <select id="contact-product-ru" name="product" class={inputBaseClass_ru + " cursor-pointer"}>
                <option value="" disabled selected>Выберите интересующий вас продукт</option>
                {productOptions_ru.map(option => (
                  <option value={option}>{option}</option>
                ))}
              </select>
            </div>
            <div>
              <label for="contact-details-ru" class="sr-only">Детали проекта</label>
              <textarea id="contact-details-ru" name="message" rows="4" class={inputBaseClass_ru} placeholder="Расскажите о вашем проекте, требуемой производительности или технических требованиях" required></textarea>
            </div>
          </div>
          <div class="mt-4 grid">
            <AuthBtn title="Отправить запрос" type="submit" id="contact-submit-button-ru" />
          </div>
          <div class="mt-3 text-center">
            <p class="text-sm text-neutral-600 dark:text-neutral-400">
              {formSubTitle_ru}
            </p>
          </div>
        </form>
      </div>

      <div class="space-y-8">
        {amirAvatarData && (
            <div class="rounded-xl border border-neutral-200 bg-neutral-100 p-4 shadow-sm dark:border-neutral-700 dark:bg-neutral-800 sm:p-6">
                <ReviewComponent 
                    amirAvatarData={amirAvatarData} 
                    avatars={avatarSrcs} 
                    starCount={starCount_ru} 
                    rating={rating_ru} 
                    reviews={reviews_ru}
                    testimonialText="Невероятно прост в управлении и обеспечивает стабильный результат от партии к партии."
                    testimonialAuthor="Amir Montazer"
                    testimonialRole="Etude Coffee Co."
                    testimonialAvatarAlt="Портрет Amir Montazer"
                />
            </div>
        )}
        <div class={`space-y-6 divide-y divide-neutral-200 dark:divide-neutral-700 ${!amirAvatarData ? 'mt-0' : ''}`}>
          <div class="pt-6 first:pt-0">
             <ContactIconBlock heading={officeHeading_ru} content={officeContent_ru} isAddressVisible={true} addressContent={officeAddress_ru}>
               <Icon name="mapPin" />
             </ContactIconBlock>
          </div>
          <div class="pt-6 first:pt-0">
             <ContactIconBlock heading={emailHeading_ru} content={emailContent_ru} isLinkVisible={true} linkTitle={emailLinkTitle_ru} linkURL={emailLinkURL_ru}>
               <Icon name="envelopeOpen" />
             </ContactIconBlock>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{botpoisonPublicKey_RU && (
  <script is:inline>
    const formElement_ru = document.getElementById("contact-form-kraffe-ru");
    const buttonElement_ru = document.getElementById("contact-submit-button-ru");

    if (formElement_ru && buttonElement_ru) {
      formElement_ru.addEventListener("botpoison-challenge-start", function () {
        buttonElement_ru.setAttribute("disabled", "disabled");
      });
      formElement_ru.addEventListener("botpoison-challenge-success", function () {
        buttonElement_ru.removeAttribute("disabled");
      });
      formElement_ru.addEventListener("botpoison-challenge-error", function () {
        buttonElement_ru.removeAttribute("disabled");
      });
    }
  </script>
)}
