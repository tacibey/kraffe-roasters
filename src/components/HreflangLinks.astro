---
// src/components/HreflangLinks.astro
import { getLanguageAlternates } from "@/utils/i18n";

interface Props {
  alternates?: {
    en?: string;
    fr?: string;
    es?: string;
  };
}

const { pathname } = Astro.url;
const { alternates: propAlternates } = Astro.props;

const { hreflang } = await getLanguageAlternates(pathname, propAlternates);

const site = Astro.site || "https://krafferoasters.com";
const enHref = hreflang.en ? new URL(hreflang.en, site).href : undefined;
const frHref = hreflang.fr ? new URL(hreflang.fr, site).href : undefined;
const esHref = hreflang.es ? new URL(hreflang.es, site).href : undefined;
const defaultHref = hreflang["x-default"] ? new URL(hreflang["x-default"], site).href : enHref;
---

{enHref && <link rel="alternate" hreflang="en" href={enHref} />}
{frHref && <link rel="alternate" hreflang="fr" href={frHref} />}
{esHref && <link rel="alternate" hreflang="es" href={esHref} />}
{defaultHref && <link rel="alternate" hreflang="x-default" href={defaultHref} />}
