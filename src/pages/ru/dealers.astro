---
// src/pages/ru/dealers.astro

import MainLayout from "../../layouts/MainLayout.astro";
import MainSection from "../../components/ui/blocks/MainSection.astro";
import DealerCard from "../../components/ui/cards/DealerCard.astro";

const dealers = [
  {
    name: "Abdullah Ali Al-Bowait",
    company: "Burj Pisa Trading Est.",
    phone: "+966 54 596 5639",
    email: "sqa2022@gmail.com",
    country: "САУДОВСКАЯ АРАВИЯ - БЛИЖНИЙ ВОСТОК - СЕВЕРНАЯ АФРИКА",
  },
];

const meta = {
  title: "Официальные дилеры ростеров | Kraffe Roasters",
  description: "Найдите авторизованных дилеров и партнеров Kraffe Roasters в вашем регионе: продажи, техническая консультация и оригинальные запчасти.",
};

const structuredData_ru = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://krafferoasters.com/ru/dealers",
  "url": "https://krafferoasters.com/ru/dealers",
  "name": meta.title,
  "description": meta.description,
  "isPartOf": {
    "@type": "WebSite",
    "url": "https://krafferoasters.com/ru",
    "name": "Kraffe Roasters",
    "description": "Высокоточные коммерческие и промышленные ростеры для кофе Kraffe Roasters."
  },
  "inLanguage": "ru-RU"
};
---

<MainLayout title={meta.title} meta={meta.description} structuredData={structuredData_ru} lang="ru">
  <MainSection
    title="Наши авторизованные дилеры"
    subTitle="Свяжитесь с нашими официальными партнерами по всему миру. Они готовы предложить вам наши ростеры для кофе и персональную поддержку."
  />

  <section class="mx-auto -mt-8 max-w-[85rem] px-4 pb-10 sm:px-6 lg:px-8 lg:pb-14">
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        dealers.map((dealer) => (
          <DealerCard
            name={dealer.name}
            company={dealer.company}
            phone={dealer.phone}
            email={dealer.email}
            country={dealer.country}
          />
        ))
      }
    </div>
  </section>
</MainLayout>
