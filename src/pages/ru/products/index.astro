const pageTitle_ru: string = `Ростеры для кофе | Каталог Kraffe Roasters`;
const metaDescription_ru: string = "Каталог коммерческих и промышленных ростеров для кофе от 1 до 240 кг. Высокая точность, модулируемые горелки и продвинутый контроль температуры.";
---

<MainLayout
  title={pageTitle_ru}
  meta={metaDescription_ru}
  lang="ru"
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE.url}/ru/products`,
    "url": `${SITE.url}/ru/products`,
    "name": pageTitle_ru,
    "description": metaDescription_ru,
    "isPartOf": {
      "@type": "WebSite",
      "url": `${SITE.url}/ru`,
      "name": "Kraffe Roasters",
      "description": "Высокоточные коммерческие и промышленные ростеры для кофе Kraffe Roasters."
    },
    "inLanguage": "ru-RU"
  }}
>
  <div
    class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full"
  >
    <div class="mb-4 flex items-center justify-between gap-8 sm:mb-8 md:mb-12">
      <div class="flex items-center gap-12">
        <h1
          class="text-balance text-2xl font-bold tracking-tight text-neutral-800 dark:text-neutral-200 md:text-4xl md:leading-tight"
        >
          {title_ru}
        </h1>
        {
          subTitle_ru && (
            <p class="hidden max-w-(--breakpoint-sm) text-pretty text-neutral-600 dark:text-neutral-400 md:block">
              {subTitle_ru}
            </p>
          )
        }
      </div>
      <PrimaryCTA title="▼ Отзывы клиентов" url="#testimonials" noArrow={true} />
    </div>

    <section class="grid grid-cols-1 gap-4 sm:grid-cols-3 md:gap-6 xl:gap-8">
      {
        product_ru.map((product_item) => {
          return <CardSmall product={product_item} productLocale="ru" />;
        })
      }
    </section>

  </div>
  <FeaturesStatsAlt
    title={featuresStatsTitle_ru}
    subTitle={featuresStatsSubTitle_ru}
    benefits={featuresStatsBenefits_ru}
  />
  <TestimonialsSectionAlt
    title={testimonialsTitle_ru}
    testimonials={testimonials_ru}
  />
</MainLayout>
