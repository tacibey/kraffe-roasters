---
// src/pages/es/dealers.astro

import MainLayout from "../../layouts/MainLayout.astro";
import MainSection from "../../components/ui/blocks/MainSection.astro";
import DealerCard from "../../components/ui/cards/DealerCard.astro";

const dealers = [
  {
    name: "Abdullah Ali Al-Bowait",
    company: "Burj Pisa Trading Est.",
    phone: "+966 54 596 5639",
    email: "sqa2022@gmail.com",
    country: "ARABIA SAUDITA - ORIENTE MEDIO - NORTE DE ÁFRICA",
  },
];

const meta = {
  title: "Distribuidores Oficiales de Tostadoras | Kraffe Roasters",
  description: "Encuentre distribuidores y socios autorizados de Kraffe Roasters en su región para ventas, asesoramiento técnico y repuestos originales.",
};

const structuredData_es = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://krafferoasters.com/es/dealers",
  "url": "https://krafferoasters.com/es/dealers",
  "name": meta.title,
  "description": meta.description,
  "isPartOf": {
    "@type": "WebSite",
    "url": "https://krafferoasters.com/es",
    "name": "Kraffe Roasters",
    "description": "Máquinas tostadoras de café comerciales e industriales de alta precisión Kraffe Roasters."
  },
  "inLanguage": "es-ES"
};
---

<MainLayout title={meta.title} meta={meta.description} structuredData={structuredData_es} lang="es">
  <MainSection
    title="Nuestros Distribuidores Autorizados"
    subTitle="Póngase en contacto con nuestros socios oficiales en todo el mundo. Están preparados para ofrecerle nuestras máquinas tostadoras de café y soporte dedicado."
  />

  <section class="mx-auto -mt-8 max-w-[85rem] px-4 pb-10 sm:px-6 lg:px-8 lg:pb-14">
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        dealers.map((dealer) => (
          <DealerCard
            name={dealer.name}
            company={dealer.company}
            phone={dealer.phone}
            email={dealer.email}
            country={dealer.country}
          />
        ))
      }
    </div>
  </section>
</MainLayout>
