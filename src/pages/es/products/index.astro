const pageTitle_es: string = `Máquinas Tostadoras de Café | Catálogo Kraffe Roasters`;
const metaDescription_es: string = "Catálogo de máquinas tostadoras de café comerciales e industriales de 1 a 240 kg. Alta precisión, quemadores modulados y control térmico avanzado.";
---

<MainLayout
  title={pageTitle_es}
  meta={metaDescription_es}
  lang="es"
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE.url}/es/products`,
    "url": `${SITE.url}/es/products`,
    "name": pageTitle_es,
    "description": metaDescription_es,
    "isPartOf": {
      "@type": "WebSite",
      "url": `${SITE.url}/es`,
      "name": "Kraffe Roasters",
      "description": "Máquinas tostadoras de café comerciales e industriales de alta precisión Kraffe Roasters."
    },
    "inLanguage": "es-ES"
  }}
>
  <div
    class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full"
  >
    <div class="mb-4 flex items-center justify-between gap-8 sm:mb-8 md:mb-12">
      <div class="flex items-center gap-12">
        <h1
          class="text-balance text-2xl font-bold tracking-tight text-neutral-800 dark:text-neutral-200 md:text-4xl md:leading-tight"
        >
          {title_es}
        </h1>
        {
          subTitle_es && (
            <p class="hidden max-w-(--breakpoint-sm) text-pretty text-neutral-600 dark:text-neutral-400 md:block">
              {subTitle_es}
            </p>
          )
        }
      </div>
      <PrimaryCTA title="▼ Referencias" url="#testimonials" noArrow={true} />
    </div>

    <section class="grid grid-cols-1 gap-4 sm:grid-cols-3 md:gap-6 xl:gap-8">
      {
        product_es.map((product_item) => {
          return <CardSmall product={product_item} productLocale="es" />;
        })
      }
    </section>

  </div>
  <FeaturesStatsAlt
    title={featuresStatsTitle_es}
    subTitle={featuresStatsSubTitle_es}
    benefits={featuresStatsBenefits_es}
  />
  <TestimonialsSectionAlt
    title={testimonialsTitle_es}
    testimonials={testimonials_es}
  />
</MainLayout>
