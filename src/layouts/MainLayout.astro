---
// src/layouts/MainLayout.astro

import Meta from "@components/Meta.astro";
import Navbar from "@components/sections/navbar&footer/Navbar.astro";
import FooterSection from "@components/sections/navbar&footer/FooterSection.astro";
import AnnouncementBanner from "@components/ui/banners/AnnouncementBanner.astro";
import { SITE } from "@data/constants";
import "@styles/global.css";
import { getRelativeLocaleUrl } from "astro:i18n";
import { ORGANIZATION_SCHEMA } from "../data_files/site_meta.ts";

interface Props {
  title?: string;
  meta?: string | { title?: string; description?: string };
  structuredData?: object;
  lang?: string;
  alternates?: {
    en?: string;
    fr?: string;
    es?: string;
  };
}

let { title, meta, structuredData, lang, alternates } = Astro.props;

const currentLang = Astro.currentLocale || lang || 'en';

// Support meta passed as an object ({ title, description })
let metaDescription: string | undefined;
if (typeof meta === "object" && meta !== null) {
  if (!title && (meta as any).title) {
    title = (meta as any).title;
  }
  metaDescription = (meta as any).description;
} else if (typeof meta === "string") {
  metaDescription = meta;
}

// Localized default title if none provided
const defaultTitles: Record<string, string> = {
  en: SITE.title,
  fr: "Kraffe Roasters | Machines à Torréfier Commerciales et Industrielles",
  es: "Kraffe Roasters | Tostadoras de Café Comerciales e Industriales",
};

let processedTitle = (title || defaultTitles[currentLang] || defaultTitles.en).trim();

// Strip any trailing global English suffix like:
// " | Kraffe Roasters | Industrial & Commercial Coffee Roasting Machines"
// or " | Industrial & Commercial Coffee Roasting Machines"
const longSuffixPattern = /\s*\|\s*Kraffe Roasters\s*\|\s*Industrial & Commercial Coffee Roasting Machines\s*$/i;
const genericSuffixPattern = /\s*\|\s*Industrial & Commercial Coffee Roasting Machines\s*$/i;

if (longSuffixPattern.test(processedTitle)) {
  processedTitle = processedTitle.replace(longSuffixPattern, "").trim();
} else if (genericSuffixPattern.test(processedTitle)) {
  processedTitle = processedTitle.replace(genericSuffixPattern, "").trim();
}

// User rule:
// "Use no suffix when the page title already contains "Kraffe", otherwise " | Kraffe Roasters"."
if (!/kraffe/i.test(processedTitle)) {
  processedTitle = `${processedTitle} | Kraffe Roasters`;
}

const contactUrl = getRelativeLocaleUrl(currentLang, 'contact');
const buttonTexts: Record<string, string> = {
  en: 'Get Offer',
  fr: 'Obtenir une offre',
  es: 'Solicitar Presupuesto',
};
const buttonText = buttonTexts[currentLang] || buttonTexts.en;
---

<html lang={currentLang} class="dark scrollbar-hide lenis lenis-smooth scroll-pt-16">
  <head>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        'ad_storage': 'denied',
        'ad_user_data': 'denied',
        'ad_personalization': 'denied',
        'analytics_storage': 'denied',
        'wait_for_update': 500
      });
    </script>

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-PLC527BM9G"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-PLC527BM9G');
    </script>
    
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-T68B8R47');</script>
    <!-- End Google Tag Manager -->

    <link rel="stylesheet" 
    href="https://cdn.jsdelivr.net/gh/orestbida/cookieconsent@v3.0.0/dist/cookieconsent.css">

    <Meta title={processedTitle} meta={metaDescription} structuredData={structuredData} alternates={alternates} />
    <title>{processedTitle}</title>
    
    <script type="application/ld+json" set:html={JSON.stringify(ORGANIZATION_SCHEMA)} />

    <style is:inline>
      h1.block { display: block; }
      h1.text-balance { text-wrap: balance; }
      h1.text-3xl { font-size: 1.875rem; line-height: 2.25rem; }
      h1.font-bold { font-weight: 700; }
      h1.tracking-tight { letter-spacing: -0.025em; }

      html.scroll-pt-16 { scroll-padding-top: 4rem; }
      html.scrollbar-hide::-webkit-scrollbar { display: none; }
      html.scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
    
    <script>
      if (window.matchMedia("(min-width: 1024px)").matches) {
        import("@scripts/lenisSmoothScroll.js");
      }
    </script>
  </head>
  <body
    class="bg-neutral-200 selection:bg-yellow-400 selection:text-neutral-700 dark:bg-neutral-800"
  >
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-T68B8R47"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <div class="mx-auto max-w-(--breakpoint-2xl) px-4 sm:px-6 lg:px-8">
      <Navbar />
      <main>
        <slot />
      </main>
    </div>

    <AnnouncementBanner
      btnId="floating-offer-button"
      btnTitle={buttonText}
      url={contactUrl}
    />

    <FooterSection />

    <script>
      import "preline/preline.js";
    </script>
    <style>
      .scrollbar-hide::-webkit-scrollbar {
        display: none;
      }
      .scrollbar-hide {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }
    </style>

    <script type="module" define:vars={{ currentLang }}>
      import * as CookieConsent from "https://cdn.jsdelivr.net/gh/orestbida/cookieconsent@v3.0.0/dist/cookieconsent.esm.js";
      
      function updateGtmConsent(categories) {
        const consentState = {
          'ad_storage': categories.includes('advertising') ? 'granted' : 'denied',
          'ad_user_data': categories.includes('advertising') ? 'granted' : 'denied',
          'ad_personalization': categories.includes('advertising') ? 'granted' : 'denied',
          'analytics_storage': categories.includes('analytics') ? 'granted' : 'denied'
        };
        
        if (typeof window.gtag === 'function') {
            window.gtag('consent', 'update', consentState);
        }
        
        window.dataLayer.push({
          'event': 'consent_update',
          'consent_status': consentState
        });
      }

      CookieConsent.run({
        guiOptions: {
          consentModal: {
            layout: 'box',
            position: 'bottom left',
            equalWeightButtons: false,
            flipButtons: false
          },
          preferencesModal: {
            layout: 'box',
            position: 'right',
            equalWeightButtons: false,
            flipButtons: false
          }
        },
        categories: {
          necessary: {
            readOnly: true,
            enabled: true
          },
          analytics: {
            enabled: true,
            autoClear: false
          },
          advertising: {
            enabled: true,
            autoClear: false
          }
        },
        language: {
          default: currentLang || 'en',
          translations: {
            en: {
              consentModal: {
                title: 'We value your privacy 🍪',
                description: 'We use cookies to enhance your experience, provide personalized content, and analyze our traffic.',
                acceptAllBtn: 'Accept All',
                showPreferencesBtn: 'Manage Preferences',
                footer: '<a href="/privacy-policy-and-terms">Privacy Policy</a>'
              },
              preferencesModal: {
                title: 'Cookie Preferences',
                acceptAllBtn: 'Accept All',
                acceptNecessaryBtn: 'Reject All',
                savePreferencesBtn: 'Save Preferences',
                closeIconLabel: 'Close',
                sections: [
                  {
                    title: 'Strictly Necessary',
                    description: 'These cookies are essential for the proper functioning of the website.',
                    linkedCategory: 'necessary'
                  },
                  {
                    title: 'Performance & Analytics',
                    description: 'These cookies allow us to count visits and traffic sources so we can measure and improve the performance of our site.',
                    linkedCategory: 'analytics'
                  },
                  {
                    title: 'Advertisement & Targeting',
                    description: 'These cookies may be set through our site by our advertising partners to build a profile of your interests.',
                    linkedCategory: 'advertising'
                  }
                ]
              }
            },
            fr: {
              consentModal: {
                title: 'Nous respectons votre vie privée 🍪',
                description: 'Nous utilisons des cookies pour améliorer votre expérience, personnaliser le contenu et analyser notre trafic.',
                acceptAllBtn: 'Tout Accepter',
                showPreferencesBtn: 'Gérer les Préférences',
                footer: '<a href="/privacy-policy-and-terms">Politique de Confidentialité</a>'
              },
              preferencesModal: {
                title: 'Préférences des Cookies',
                acceptAllBtn: 'Tout Accepter',
                acceptNecessaryBtn: 'Tout Refuser',
                savePreferencesBtn: 'Enregistrer les Préférences',
                closeIconLabel: 'Fermer',
                sections: [
                  {
                    title: 'Strictement Nécessaires',
                    description: 'Ces cookies sont indispensables au bon fonctionnement du site web.',
                    linkedCategory: 'necessary'
                  },
                  {
                    title: 'Performance & Analyse',
                    description: 'Ces cookies nous permettent de mesurer et d’améliorer les performances de notre site.',
                    linkedCategory: 'analytics'
                  },
                  {
                    title: 'Publicité & Ciblage',
                    description: 'Ces cookies peuvent être configurés par nos partenaires publicitaires pour établir un profil de vos intérêts.',
                    linkedCategory: 'advertising'
                  }
                ]
              }
            },
            es: {
              consentModal: {
                title: 'Valoramos su privacidad 🍪',
                description: 'Utilizamos cookies para optimizar su experiencia, personalizar contenidos y analizar el tráfico de nuestro sitio.',
                acceptAllBtn: 'Aceptar Todo',
                showPreferencesBtn: 'Gestionar Preferencias',
                footer: '<a href="/privacy-policy-and-terms">Política de Privacidad</a>'
              },
              preferencesModal: {
                title: 'Preferencias de Cookies',
                acceptAllBtn: 'Aceptar Todo',
                acceptNecessaryBtn: 'Rechazar Todo',
                savePreferencesBtn: 'Guardar Preferencias',
                closeIconLabel: 'Cerrar',
                sections: [
                  {
                    title: 'Estrictamente Necesarias',
                    description: 'Estas cookies son indispensables para el correcto funcionamiento del sitio web.',
                    linkedCategory: 'necessary'
                  },
                  {
                    title: 'Rendimiento y Analítica',
                    description: 'Estas cookies nos permiten contar las visitas y fuentes de tráfico para medir y mejorar el rendimiento de nuestro sitio.',
                    linkedCategory: 'analytics'
                  },
                  {
                    title: 'Publicidad y Personalización',
                    description: 'Estas cookies pueden ser establecidas por nuestros socios publicitarios para elaborar un perfil de sus intereses.',
                    linkedCategory: 'advertising'
                  }
                ]
              }
            }
          }
        },
        onConsent: ({ cookie }) => {
          updateGtmConsent(cookie.categories);
        },
        onChange: ({ cookie }) => {
          updateGtmConsent(cookie.categories);
        }
      });
    </script>

    <style is:global>
      :root {
        --cc-bg: #1a1a1a;
        --cc-text: #e5e5e5;
        --cc-btn-primary-bg: #F25F29;
        --cc-btn-primary-text: #ffffff;
        --cc-btn-primary-hover-bg: #d14d1f;
        --cc-btn-secondary-bg: #333333;
        --cc-btn-secondary-text: #ffffff;
        --cc-btn-secondary-hover-bg: #444444;
        --cc-toggle-on-bg: #F25F29;
        --cc-font-family: inherit;
      }

      /* --- HACK: INP İyileştirmesi --- */
      /* Mobilde butonlara basınca oluşan 300ms gecikmeyi yok eder */
      html {
        touch-action: manipulation;
      }

      #cc-main .cm__btn[data-role="necessary"] {
        display: none !important;
      }

      #cc-main .cm__btn {
        border-radius: 4px;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 0.05em;
      }

      #cc-main .cm__btn[data-role="all"] {
        background-color: var(--cc-btn-primary-bg);
        color: var(--cc-btn-primary-text);
      }
      
      #cc-main a {
        color: #F25F29;
      }
      
      #cc-main .cm__title,
      #cc-main .pm__title {
        color: #f3f4f6 !important;
      }

      #cc-main .cm__btn--secondary, 
      #cc-main .pm__btn--secondary {
        color: #f3f4f6 !important;
        border: 1px solid #444 !important;
      }
    </style>

  </body>
</html>
